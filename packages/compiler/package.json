{
  "name": "deshijs",
  "version": "3.0.0",
  "description": "Compiler and Vite plugin for .deshi — a zero-JS static site framework.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "client-directives.d.ts",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js",
      "default": "./dist/content.js"
    },
    "./client-directives": {
      "types": "./client-directives.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "css-tree": "^3.2.1",
    "esbuild": "^0.28.2",
    "parse5": "^8.0.1"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.19.17",
    "typescript": "^7.0.2",
    "vite": "^7.3.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "deshi",
    "vite",
    "vite-plugin",
    "ssg",
    "static-site",
    "compiler",
    "zero-js"
  ]
}

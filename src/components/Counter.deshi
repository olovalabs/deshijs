<script>
  const start = Number(props.start ?? 0);
  const step = Number(props.step ?? 1);
  const hydrated = false;
</script>

<div class="counter">
  <p class="counter-hydrated">hydrated: <span data-hydrated>{String(hydrated)}</span></p>
  <div class="counter-value" data-count>{start}</div>
  <div class="counter-buttons">
    <button type="button" data-inc>+1</button>
  </div>
  <p class="counter-note">SSR {start} · step {step}</p>
</div>

<script client>
  const step = Number(ctx.props.step ?? 1);
  const el = root.querySelector('[data-count]');
  const flag = root.querySelector('[data-hydrated]');
  const btn = root.querySelector('[data-inc]');
  let n = Number(el && el.textContent);
  if (flag) flag.textContent = 'true';
  if (btn) {
    btn.addEventListener('click', function () {
      n += step;
      if (el) el.textContent = String(n);
    });
  }
</script>

<style>
  .counter {
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
    padding: 1.5rem;
    max-width: 420px;
  }
  .counter-hydrated {
    color: #71717a;
    font-size: 0.85rem;
    text-align: center;
    margin: 0 0 0.5rem;
  }
  .counter-value {
    font-size: 3rem;
    font-weight: 800;
    color: #a3e635;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .counter-buttons {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1rem;
  }
  .counter-buttons button {
    background: #27272a;
    color: #fafafa;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    cursor: pointer;
  }
  .counter-buttons button:hover {
    background: #3f3f46;
  }
  .counter-note {
    color: #71717a;
    font-size: 0.85rem;
    text-align: center;
  }
</style>

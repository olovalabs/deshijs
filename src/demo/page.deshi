---
import Counter from '../components/Counter.deshi';
const heroColor = "#a3e635";
const isActive = true;
const label = "set:text demo — Astro parity";
---
<head>
  <title>Demo · Deshi Super-Power</title>
  <meta name="description" content="Deshi Astro parity demo: class:list, define:vars, set:text, client:media, client:only, transition:*" />
</head>

<div class="demo">
  <span class="badge">Route: /demo — Astro parity showcase</span>
  <h1 transition:name="hero">Deshi <span style="color: var(--hero)">SuperPower</span> ✨</h1>
  <p class="lead">Same to same Astro + tiny SPA. This page demos every new directive.</p>

  <section class="card">
    <h2>class:list + define:vars + transition:name</h2>
    <p class="muted">class:list merges strings/objects; define:vars injects CSS vars into scoped style.</p>
    <div class:list={["pill", { active: isActive, idle: !isActive }]} define:vars={{ hero: heroColor }} transition:animate="slide">
      heroColor = {heroColor} — scoped var + transition
    </div>
  </section>

  <section class="card">
    <h2>set:html vs set:text</h2>
    <p class="muted">set:html is unsafe (SSR innerHTML), set:text is escaped.</p>
    <div class="grid">
      <div class="box"><strong>set:html</strong><div set:html={"<em>italic via set:html</em>"}></div></div>
      <div class="box"><strong>set:text</strong><div set:text={label}></div></div>
    </div>
  </section>

  <section class="card">
    <h2>Islands: media + click + visible + idle</h2>
    <p class="muted">Astro `client:media` hydrates only when the media query matches. Try resizing.</p>
    <div class="island-grid">
      <div>
        <h3>client:media="(max-width: 768px)"</h3>
        <Counter client:media="(max-width: 768px)" client:props={{ start: 5, step: 2 }} />
      </div>
      <div>
        <h3>client:click</h3>
        <Counter client:click client:props={{ start: 0, step: 1 }} />
      </div>
    </div>
    <p class="hint">Scroll down for <code>client:visible</code> + <code>client:idle</code> (same as /counter)</p>
  </section>

  <div class="spacer"><span>↓ visible/idle islands hydrate on scroll ↓</span></div>

  <section class="card">
    <h2>client:visible + client:idle</h2>
    <Counter client:visible client:props={{ start: 10, step: 10 }} />
    <Counter client:idle client:props={{ start: 100, step: 5 }} />
  </section>

  <section class="card">
    <h2>Astro global</h2>
    <p>params = <code>{JSON.stringify(params)}</code> — url = <code>{url.pathname}</code> — Astro.url = <code>{Astro.url.pathname}</code></p>
  </section>

  <section class="card">
    <h2>View Transitions</h2>
    <p class="muted">Add <code>transition:name="hero"</code> above; enable <code>experimental.viewTransitions</code> in <code>deshi.config.ts</code> to wrap swaps in <code>document.startViewTransition</code>.</p>
    <p><a href="/">← Back home (SPA navigation, no reload)</a> · <a href="/counter">→ Go to /counter via SPA</a></p>
  </section>
</div>

<style>
  .demo { max-width: 860px; }
  .badge { display:inline-block; padding:0.25rem 0.75rem; font-size:0.75rem; font-weight:600; color:#a3e635; background: rgba(163,230,53,0.1); border:1px solid rgba(163,230,53,0.3); border-radius:9999px; margin-bottom:1rem; }
  h1 { font-size:2.6rem; margin:0 0 0.5rem; color:#fafafa; }
  .lead { color:#a1a1aa; margin:0 0 2rem; font-size:1.15rem; }
  .card { background:#121215; border:1px solid #27272a; border-radius:12px; padding:1.25rem; margin-bottom:1.25rem; }
  .card h2 { margin:0 0 0.5rem; font-size:1.15rem; color:#fafafa; }
  .card h3 { margin:0.5rem 0 0.25rem; font-size:0.95rem; color:#e4e4e7; }
  .muted { color:#71717a; font-size:0.9rem; margin:0 0 0.75rem; }
  .hint { color:#71717a; font-size:0.85rem; margin-top:0.75rem; }
  .pill { display:inline-block; padding:0.35rem 0.75rem; border-radius:9999px; border:1px solid #27272a; background:#18181b; color:#a1a1aa; }
  .pill.active { border-color:#a3e635; color:#a3e635; background: rgba(163,230,53,0.08); }
  .grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .box { background:#09090b; border:1px solid #18181b; border-radius:8px; padding:0.75rem; }
  .island-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .spacer { min-height:60vh; display:grid; place-items:center; color:#52525b; border:1px dashed #27272a; border-radius:12px; margin:1rem 0; }
  a { color:#38bdf8; }
</style>

<style is:global>
  /* is:global demo — unscoped */
  .demo a:hover { color:#a3e635; }
</style>

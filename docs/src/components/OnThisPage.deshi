<script>
  const title = props.title || "On this page";
  const items = props.items || [
    { href: "#overview", label: "Overview" },
  ];
</script>

<!-- RIGHT SIDEBAR: "ON THIS PAGE" (holocron TOC column, sticky) -->
<aside class="slot-sidebar-right hidden xl:block shrink-0 lg:sticky lg:top-(--sticky-top) lg:h-[calc(100vh-var(--sticky-top))] overflow-y-auto py-8 scrollbar-thin">
  <div class="space-y-6">
    <div>
      <h2 class="toc-heading">{title}</h2>

      <!-- TOC link tree (Dynamically updated for .md headings) -->
      <ul id="toc-list" class="toc-list">
        {items.map((item) => (
          <li>
            <a href={item.href} class="toc-link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="pt-4 border-t border-divider text-[12px] text-text-tertiary space-y-2">
      <a href="https://github.com/olovalabs/deshi" target="_blank" rel="noreferrer" class="flex items-center gap-2 hover:text-muted-foreground transition">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
        <span>Edit this page on GitHub</span>
      </a>
      <a href="#top" class="flex items-center gap-2 hover:text-muted-foreground transition">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
        <span>Back to top</span>
      </a>
    </div>
  </div>
</aside>

<!-- Auto-generate Table of Contents from headings on page load and client navigation -->
<script client>
  (() => {
    function refreshToc() {
      const list = document.getElementById('toc-list');
      const headings = document.querySelectorAll('main h2[id], main h3[id]');
      if (!list || headings.length === 0) return;
      list.innerHTML = '';
      headings.forEach((h) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent.replace(/^#\s*/, '');
        const isH3 = h.tagName.toLowerCase() === 'h3';
        a.className = isH3 ? 'toc-link toc-link-child' : 'toc-link';
        li.appendChild(a);
        list.appendChild(li);
      });
    }
    refreshToc();
    window.addEventListener('deshi:navigated', refreshToc);
  })();
</script>

<script>
  const type = props.type || 'note';
  // Holocron-style callouts: a flat tinted panel (background mixed with the
  // accent) and an inline bold label — no borders, no uppercase headers.
  const palette = {
    note: { bg: 'color-mix(in srgb, var(--background) 94%, var(--blue))', fg: 'var(--blue)' },
    tip: { bg: 'color-mix(in srgb, var(--background) 94%, var(--green))', fg: 'var(--green)' },
    warning: { bg: 'color-mix(in srgb, var(--background) 94%, var(--yellow))', fg: 'var(--yellow)' },
    danger: { bg: 'color-mix(in srgb, var(--background) 94%, var(--red))', fg: 'var(--red)' },
  };
  const labels = { note: 'Note', tip: 'Tip', warning: 'Warning', danger: 'Caution' };
  const tone = palette[type] || palette.note;
  const label = props.title || labels[type] || 'Note';
</script>

<!-- MDX AUTHORING COMPONENT — used from .mdx docs pages via `import Callout from '../components/Callout.deshi'` -->
<div class="callout my-5" style={`background:${tone.bg};color:var(--prose-text)`}>
  <svg
    class="w-4 h-4 shrink-0 mt-0.5"
    style={`color:${tone.fg}`}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    {type === 'tip' ? (
      <g>
        <path d="M9 18h6"></path>
        <path d="M10 22h4"></path>
        <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.4 1 2.3h6c0-.9.4-1.8 1-2.3A7 7 0 0 0 12 2z"></path>
      </g>
    ) : type === 'warning' ? (
      <g>
        <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </g>
    ) : type === 'danger' ? (
      <g>
        <circle cx="12" cy="12" r="9"></circle>
        <line x1="15" y1="9" x2="9" y2="15"></line>
        <line x1="9" y1="9" x2="15" y2="15"></line>
      </g>
    ) : (
      <g>
        <circle cx="12" cy="12" r="9"></circle>
        <line x1="12" y1="11" x2="12" y2="16"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </g>
    )}
  </svg>
  <div class="text-[14px]">
    <strong class="font-[560]" style={`color:${tone.fg}`}>{label}</strong>
    <slot />
  </div>
</div>

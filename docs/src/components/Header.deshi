<script>
  const logo = props.logo || "/deshi.svg";
  const brand = props.brand || "Deshi";
  const showSidebarToggle = props.sidebar !== undefined ? props.sidebar : true;
</script>

<!-- TOP HEADER (0 JS) - 100% FULL WIDTH EDGE-TO-EDGE -->
<header class="sticky top-0 z-40 h-14 bg-[#0c0d10] border-b border-[#1c1d22] px-4 lg:px-6 flex items-center justify-between backdrop-blur-md bg-opacity-95 w-full">
  <!-- Left: Hamburger (mobile) + Deshi Logo + Deshi -->
  <div class="flex items-center gap-3">
    <!-- Mobile hamburger button (0 JS label) -->
    {showSidebarToggle ? (
      <label for="mobile-sidebar-toggle" class="lg:hidden p-1.5 -ml-1 text-zinc-400 hover:text-white rounded-md hover:bg-[#1c1d22] cursor-pointer" aria-label="Toggle navigation">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </label>
    ) : null}

    <a href="/" class="flex items-center gap-2.5 group">
      <img src={logo} alt="{brand} Logo" class="w-7 h-7 shrink-0 transition-transform group-hover:scale-105 object-contain" />
      <span class="text-white font-bold text-base tracking-tight font-sans">{brand}</span>
      <span class="hidden sm:inline-block px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold bg-primary/10 text-primary border border-primary/25">v1.0</span>
    </a>

    <!-- Top nav desktop links -->
    <nav class="hidden md:flex items-center gap-1 pl-4 border-l border-[#1f2026] text-xs">
      <a href="/docs" class="px-2.5 py-1 text-zinc-300 hover:text-white hover:bg-[#16171b] rounded-md transition font-medium">Docs</a>
      <a href="/docs/architecture" class="px-2.5 py-1 text-zinc-400 hover:text-white hover:bg-[#16171b] rounded-md transition">Architecture</a>
      <a href="/docs/routing" class="px-2.5 py-1 text-zinc-400 hover:text-white hover:bg-[#16171b] rounded-md transition">Routing</a>
      <a href="/docs/islands" class="px-2.5 py-1 text-zinc-400 hover:text-white hover:bg-[#16171b] rounded-md transition">Islands</a>
      <a href="/docs/api-reference" class="px-2.5 py-1 text-zinc-400 hover:text-white hover:bg-[#16171b] rounded-md transition">API</a>
      <a href="/docs/error-catalog" class="px-2.5 py-1 text-zinc-400 hover:text-white hover:bg-[#16171b] rounded-md transition">Errors</a>
    </nav>
  </div>

  <!-- Right: Search Bar & External Links -->
  <div class="flex items-center gap-3">
    <!-- Search trigger bar (responsive) -->
    <div class="relative flex items-center">
      <div class="hidden sm:flex items-center gap-2 bg-[#141518] hover:bg-[#1a1b20] border border-[#24262c] hover:border-zinc-700 text-zinc-400 text-xs px-3 py-1.5 rounded-lg w-44 sm:w-52 transition cursor-pointer">
        <svg class="w-3.5 h-3.5 text-zinc-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="text-zinc-500 select-none text-[12px]">Search docs...</span>
        <span class="ml-auto flex items-center gap-0.5 text-[10px] text-zinc-400 bg-[#1e2025] px-1.5 py-0.5 rounded border border-[#2d2f38] font-mono select-none">
          Ctrl K
        </span>
      </div>

      <button type="button" aria-label="Search" class="sm:hidden text-zinc-400 hover:text-white p-1.5 rounded-md hover:bg-[#1c1d22] transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>

    <!-- GitHub icon link -->
    <a href="https://github.com/olovalabs/deshi" target="_blank" rel="noreferrer" class="p-1.5 text-zinc-400 hover:text-white rounded-md hover:bg-[#1c1d22] transition" title="GitHub Repository">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
      </svg>
    </a>
  </div>
</header>

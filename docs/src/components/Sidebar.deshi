<script>
  const brand = props.brand || "Deshi Docs";
  const version = props.version || "3.1.0";

  const sections = [
    {
      label: "Getting Started",
      items: [
        { label: "Overview & Quickstart", href: "/docs" },
        { label: "Architecture & Pipeline", href: "/docs/architecture" },
        { label: "Vite Plugin & Dev Server", href: "/docs/vite-plugin" },
      ],
    },
    {
      label: "Core Concepts",
      items: [
        { label: "Template Syntax & AST", href: "/docs/template-syntax" },
        { label: "Islands & client:*", href: "/docs/islands", badge: { text: "0JS", tone: "primary" } },
        { label: "Directives & Astro Parity", href: "/docs/directives" },
        { label: "Scoped Styling & CSS", href: "/docs/styling" },
      ],
    },
    {
      label: "Routing & Data",
      items: [
        { label: "File-Based Routing", href: "/docs/routing" },
        { label: "Static Params & Paths", href: "/docs/static-params" },
        { label: "Content Collections", href: "/docs/content-collections" },
        { label: "Markdown & MDX", href: "/docs/markdown" },
      ],
    },
    {
      label: "Client & Runtime",
      items: [
        { label: "Client Router & SPA", href: "/docs/client-router", badge: { text: "1KB", tone: "blue" } },
        { label: "Runtime API & Astro.*", href: "/docs/runtime-api" },
        { label: "deshi.config.ts Reference", href: "/docs/config" },
      ],
    },
    {
      label: "Reference",
      items: [
        { label: "Programmatic API", href: "/docs/api-reference", badge: { text: "API", tone: "purple" } },
        { label: "Diagnostic Catalog", href: "/docs/error-catalog", badge: { text: "PF*", tone: "amber" } },
      ],
    },
  ];

  // Current page (trailing slash ignored). `url` is provided by the renderer for
  // every page; the client script below re-syncs this after SPA navigations.
  const rawPath = props.current || (url && url.pathname) || "/";
  const current = rawPath.length > 1 && rawPath.endsWith("/") ? rawPath.slice(0, -1) : rawPath;

  const isActive = (href) => href === current;
  const containsActive = (section) => section.items.some((item) => isActive(item.href));

  // Active styling lives in the component <style> (keyed off `data-active`), so
  // the client only has to flip one attribute per row — no class-string drift.
  const summaryClass =
    "flex items-center justify-between gap-2 px-2.5 py-1.5 rounded-md cursor-pointer select-none transition text-zinc-200 hover:text-white hover:bg-[#16171b]";
  const itemClass =
    "flex items-center justify-between gap-2 px-2.5 py-1.5 rounded-md transition text-zinc-400 hover:text-white hover:bg-[#16171b]";

  const badgeClass = (tone) =>
    ({
      primary: "bg-primary/20 text-primary font-mono font-semibold",
      blue: "bg-blue-950/80 text-blue-400 border border-blue-800/40 font-mono",
      purple: "bg-purple-950/80 text-purple-300 border border-purple-800/40",
      amber: "bg-amber-950/80 text-amber-300 border border-amber-800/40 font-mono",
    })[tone] || "bg-[#1f2026] text-zinc-400 font-mono";
</script>

<!-- LEFT SIDEBAR (Pinned to Left Edge, w-64) -->
<aside class="fixed inset-y-0 left-0 z-50 w-64 bg-[#0c0d10] border-r border-[#1c1d22] overflow-y-auto px-4 py-4 scrollbar-thin transition-transform duration-300 ease-in-out -translate-x-full peer-checked:translate-x-0 lg:translate-x-0 lg:static lg:z-auto lg:h-[calc(100vh-3.5rem)] lg:sticky lg:top-14 lg:bg-[#0c0d10]/60 shrink-0">

  <!-- Mobile Drawer Close Header (0 JS) -->
  <div class="flex items-center justify-between mb-3 pb-3 border-b border-[#1c1d22] lg:hidden">
    <div class="flex items-center gap-2">
      <img src="/deshi.svg" alt="" class="w-5 h-5 shrink-0 object-contain" />
      <span class="text-xs font-bold text-white font-sans">{brand}</span>
    </div>
    <label for="mobile-sidebar-toggle" class="p-1.5 text-zinc-300 hover:text-white rounded-md hover:bg-[#1c1d22] cursor-pointer" aria-label="Close sidebar">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </label>
  </div>

  <!-- Brand / version card -->
  <div class="mb-4">
    <a href="/docs" class="flex items-center gap-2.5 px-3 py-2 rounded-lg bg-[#14151a] hover:bg-[#1b1d22] border border-[#23242c] text-zinc-300 transition text-xs group">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span class="font-medium text-white">Deshijs Compiler</span>
      <span class="ml-auto text-[10px] text-zinc-500 font-mono">v{version}</span>
    </a>
  </div>

  <!-- Collapsible nav tree (native <details>; every section starts expanded) -->
  <nav class="space-y-0.5 text-[13px] font-medium font-sans" aria-label="Documentation">
    {sections.map((section) => (
      <details open>
        <summary data-nav-summary data-active={containsActive(section) ? "true" : "false"} class={summaryClass}>
          <span>{section.label}</span>
          <svg class="chev w-3.5 h-3.5 shrink-0 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="9 6 15 12 9 18"></polyline>
          </svg>
        </summary>

        <div class="mt-0.5 mb-1.5 ml-[15px] border-l border-[#202128] pl-2 space-y-0.5">
          {section.items.map((item) => (
            <a
              href={item.href}
              data-nav-link
              data-active={isActive(item.href) ? "true" : "false"}
              aria-current={isActive(item.href) ? "page" : null}
              class={itemClass}
            >
              <span class="min-w-0 truncate">{item.label}</span>
              {item.badge ? (
                <span class={`text-[9px] px-1.5 py-0.5 rounded shrink-0 ${badgeClass(item.badge.tone)}`}>{item.badge.text}</span>
              ) : null}
            </a>
          ))}
        </div>
      </details>
    ))}
  </nav>
</aside>

<script client>
  // The client router swaps <main> only, so the sidebar persists and its
  // server-rendered active state would go stale. Re-sync it on every navigation.
  const normalize = (p) => (p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p);

  function syncActive() {
    const here = normalize(location.pathname);

    root.querySelectorAll("[data-nav-link]").forEach((link) => {
      const on = link.getAttribute("href") === here;
      link.dataset.active = on ? "true" : "false";
      if (on) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });

    root.querySelectorAll("[data-nav-summary]").forEach((summary) => {
      const section = summary.closest("details");
      const on = !!section && !!section.querySelector(`[data-nav-link][href="${here}"]`);
      summary.dataset.active = on ? "true" : "false";
    });

    // Close the mobile drawer so the new page is visible after navigation.
    const toggle = document.getElementById("mobile-sidebar-toggle");
    if (toggle) toggle.checked = false;
  }

  syncActive();
  window.addEventListener("deshi:navigated", syncActive);
</script>

<style>
  /* Native disclosure widget: hide the default marker, rotate our chevron. */
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .chev {
    transition: transform 0.15s ease;
  }
  details[open] > summary .chev {
    transform: rotate(90deg);
  }

  /* Active row styling — driven by `data-active` so SSR and client agree. */
  [data-nav-summary][data-active="true"] {
    color: var(--color-primary);
    background: color-mix(in oklab, var(--color-primary) 12%, transparent);
    font-weight: 500;
  }
  [data-nav-link][data-active="true"] {
    color: var(--color-primary);
    font-weight: 500;
  }
</style>

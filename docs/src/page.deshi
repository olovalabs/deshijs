  <span class="code-keyword">return</span> [&#123; params: &#123; slug: <span class="code-string">"quickstart"</span> &#125; &#125;];
&#125;

<span class="code-comment">// Resolved params passed via props</span>
<span class="code-keyword">const</span> &#123; slug &#125; = props.params;</code></pre>

            <pre><code><span class="code-comment">&lt;!-- Hydrate only when visible on screen --&gt;</span>
&lt;<span class="code-keyword">Counter</span> client:visible /&gt;

<span class="code-comment">&lt;!-- Hydrate when browser is idle --&gt;</span>
&lt;<span class="code-keyword">SearchDialog</span> client:idle /&gt;</code></pre>

<script>
  import docs from '../../data/docs.js';

  const defaultArticles = {
    "getting-started": {
      title: "Getting Started with Deshi",
      date: "Sep 2026",
      readTime: "3 min read",
      content: "<p>Creating static pages in Deshi is effortless. Simply create layout.deshi and page.deshi in your src directory. No complex boilerplate needed!</p>"
    },
    "architecture": {
      title: "Under the Hood: AST Compiler & Vite",
      date: "Sep 2026",
      readTime: "5 min read",
      content: "<p>Deshi uses parse5 for HTML parsing, acorn + acorn-jsx for JavaScript expressions, and css-tree for style scoping. At build time, Vite drives static HTML generation.</p>"
    }
  };

  export async function getStaticParams() {
    const staticList = [
      { slug: "getting-started" },
      { slug: "architecture" }
    ];
    return [...staticList, ...docs.map((d) => ({ slug: d.slug }))];
  }

  const currentSlug = params.slug;
  const docMatch = docs.find((d) => d.slug === currentSlug);
  const post = docMatch || defaultArticles[currentSlug] || {
    title: "Article Not Found",
    date: "",
    readTime: "",
    content: "<p>This article does not exist.</p>"
  };
</script>

<head>
  <title>{post.title} · Deshi Blog</title>
</head>

<article class="article">
  <div class="badge-row">
    <span class="badge">Dynamic Route: /blog/{currentSlug}</span>
    {post.readTime ? <span class="badge badge-accent">{post.readTime}</span> : null}
  </div>

  <h1>{post.title}</h1>
  <time class="meta">{post.date}</time>

  <div class="body" set:html={post.content}></div>

  <div class="footer-nav">
    <a href="/blog" class="back-link">&larr; Back to all posts</a>
    {post.sourceUrl ? (
      <a href={post.sourceUrl} target="_blank" rel="noopener noreferrer" class="source-link">
        Original Article on Cloudflare Blog &nearr;
      </a>
    ) : null}
  </div>
</article>


<script>
  import docs from '../../data/docs.js';

  export async function getStaticParams() {
    return docs.map((d) => ({ slug: d.slug }));
  }

  const currentSlug = params.slug;
  const docIndex = docs.findIndex((d) => d.slug === currentSlug);
  const doc = docs[docIndex] || {
    title: "Document Not Found",
    date: "",
    readTime: "",
    excerpt: "",
    content: "<p>The requested document was not found.</p>",
    sourceUrl: "https://blog.cloudflare.com/tag/casb/"
  };

  const prevDoc = docIndex > 0 ? docs[docIndex - 1] : null;
  const nextDoc = docIndex >= 0 && docIndex < docs.length - 1 ? docs[docIndex + 1] : null;
</script>

<head>
  <title>{doc.title} · Cloudflare CASB Docs</title>
  <meta name="description" content={doc.excerpt} />
</head>

<div class="doc-layout">
  <aside class="doc-sidebar">
    <div class="sidebar-header">
      <a href="/docs" class="sidebar-back">&larr; All Documents</a>
      <h3>CASB Specs (10)</h3>
    </div>
    <ul class="sidebar-nav">
      {docs.map((d, i) => (
        <li class={d.slug === currentSlug ? "active" : ""}>
          <a href={`/docs/${d.slug}`}>
            <span class="nav-idx">{i + 1}.</span>
            <span class="nav-title">{d.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>

  <article class="doc-content">
    <nav class="breadcrumb">
      <a href="/">Home</a> / <a href="/docs">Docs</a> / <span class="current">CASB Spec</span>
    </nav>

    <header class="doc-article-header">
      <div class="badge-row">
        <span class="badge">Cloudflare CASB</span>
        <span class="badge badge-accent">{doc.readTime || "Deep Dive"}</span>
      </div>

      <h1>{doc.title}</h1>

      <div class="meta-bar">
        <span class="meta-date">Published: {doc.date}</span>
        <span class="meta-dot">&bull;</span>
        <a href={doc.sourceUrl} target="_blank" rel="noopener noreferrer" class="source-link">
          Official Cloudflare Post &nearr;
        </a>
      </div>

      {doc.excerpt ? (
        <div class="abstract-box">
          <strong>Overview:</strong> {doc.excerpt}
        </div>
      ) : null}
    </header>

    <div class="article-body" set:html={doc.content}></div>

    <footer class="doc-article-footer">
      <div class="doc-pagination">
        {prevDoc ? (
          <a href={`/docs/${prevDoc.slug}`} class="prev-link">
            <span class="nav-dir">&larr; Previous Document</span>
            <span class="nav-label">{prevDoc.title}</span>
          </a>
        ) : <div />}

        {nextDoc ? (
          <a href={`/docs/${nextDoc.slug}`} class="next-link">
            <span class="nav-dir">Next Document &rarr;</span>
            <span class="nav-label">{nextDoc.title}</span>
          </a>
        ) : null}
      </div>

      <div class="bottom-back">
        <a href="/docs" class="back-link">&larr; Return to Documentation Overview</a>
      </div>
    </footer>
  </article>
</div>


  import SvelteWidget from '../components/SvelteWidget.svelte';
  import PreactWidget from '../components/PreactWidget.tsx';
</script>

<head>
  <title>Multi-Framework Islands · Deshijs</title>
  <meta name="description" content="Multi-framework islands showcase: React, Preact, Vue, and Svelte running inside Deshijs." />
</head>

<div class="multi-page">
  <span class="badge">Route: /multi · Astro-like Multi-Framework</span>
  <h1>Multi-Framework Islands</h1>
  <p class="lede">
    Deshijs allows importing and hydrating components authored in <strong>React (JSX/TSX)</strong>,
    <strong>Vue 3 (.vue)</strong>, <strong>Svelte (.svelte)</strong>, and <strong>Preact</strong>
    directly inside <code>.deshi</code> templates with zero configuration.
  </p>

  <section class="section">
    <h2>1 · Interactive Islands (Hydration)</h2>
    <p class="muted">
      Each component below is an independent island running its respective framework runtime.
      Props are serialized automatically into <code>data-deshi-props</code> at build time.
    </p>

    <div class="grid">
      <!-- React Island -->
      <ReactWidget name="Interactive React Island" initial={100} client:load />

      <!-- Vue Island -->
      <VueWidget title="Dynamic Vue 3 Island" description="Hydrates on viewport entry via IntersectionObserver." client:visible />

      <!-- Svelte Island -->
      <SvelteWidget title="Lightweight Svelte Island" count={7} client:idle />

      <!-- Preact Island -->
      <PreactWidget title="Fast Preact Island" speed={120} client:visible />
    </div>
  </section>

  <section class="section">
    <h2>2 · Zero-JS Static Mode (0 Bytes JS)</h2>
    <p class="muted">
      The exact same framework components can also be rendered <strong>statically</strong> on the server.
      Without a <code>client:*</code> directive, Deshijs emits pure HTML and ships <strong>0 bytes of client JavaScript</strong>.
    </p>

    <div class="grid">
      <ReactWidget name="Static React (0-JS)" initial={0} />
      <VueWidget title="Static Vue (0-JS)" description="Rendered on server, 0 bytes JS sent to browser." />
      <SvelteWidget title="Static Svelte (0-JS)" count={0} />
      <PreactWidget title="Static Preact (0-JS)" speed={0} />
    </div>
  </section>
</div>

